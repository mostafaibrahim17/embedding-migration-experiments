# SciFact documents carrying two embedding spaces at once: the old model's vector
# and, once the backfill reaches them, the new model's vector. The point of the
# schema is that a document can hold both without being rewritten, which is the
# claim the article makes about Vespa and the thing the backfill run measures.

schema scifact {

    document scifact {

        field doc_id type string {
            indexing: summary | attribute
        }

        field text type string {
            indexing: summary | index
        }

        # Which space this document's live vector is in: 0 = old, 1 = migrated.
        # fast-search because every mixed-state query filters on it.
        field space type int {
            indexing: summary | attribute
            attribute: fast-search
        }

        # Both vectors are L2-normalized by the embedder, so prenormalized-angular
        # is the right metric. M and ef_construction match the hnswlib settings in
        # scripts/stage3_hnsw_and_distant_pair.py so the two runs are comparable.
        field emb_old type tensor<float>(x[384]) {
            indexing: attribute | index
            attribute {
                distance-metric: prenormalized-angular
            }
            index {
                hnsw {
                    max-links-per-node: 16
                    neighbors-to-explore-at-insert: 200
                }
            }
        }

        field emb_new type tensor<float>(x[384]) {
            indexing: attribute | index
            attribute {
                distance-metric: prenormalized-angular
            }
            index {
                hnsw {
                    max-links-per-node: 16
                    neighbors-to-explore-at-insert: 200
                }
            }
        }
    }

    fieldset default {
        fields: text
    }

    # Before the migration: old query model against old document vectors.
    rank-profile old {
        inputs {
            query(q) tensor<float>(x[384])
        }
        first-phase {
            expression: closeness(field, emb_old)
        }
    }

    # After the migration: new query model against new document vectors. Deployed
    # from the start, so the switch at the end is a query parameter, not a deploy.
    rank-profile new {
        inputs {
            query(q) tensor<float>(x[384])
        }
        first-phase {
            expression: closeness(field, emb_new)
        }
    }

    # The mixed state. One new-model query vector reaches two HNSW graphs through
    # two labelled nearestNeighbor operators, and each document is scored in
    # whichever space it currently lives in. Taking the max of two closeness
    # values across different embedding spaces is the score incomparability the
    # article describes, made explicit as a rank expression.
    rank-profile mixed {
        inputs {
            query(q) tensor<float>(x[384])
        }
        first-phase {
            expression: max(closeness(label, "n"), closeness(label, "o"))
        }
    }

    # Per-space normalization, as a rank expression rather than a pass in numpy.
    #
    # A first-phase expression sees one document at a time, so it cannot know the
    # distribution of scores it is part of. The per-space mean and standard
    # deviation therefore arrive as query inputs, computed per query by the
    # caller, and the expression z-scores each document inside its own space
    # before the two spaces are compared.
    #
    # It ranks on the raw cosine rather than on closeness(), because that is the
    # quantity the numpy runs normalize and the two have to be the same thing to
    # be comparable. The vectors are unit length, so a dot product is the cosine.
    rank-profile mixed_normalized {
        inputs {
            query(q) tensor<float>(x[384])
            query(mu_n) double
            query(sd_n) double
            query(mu_o) double
            query(sd_o) double
        }
        function cos_new() {
            expression: sum(query(q) * attribute(emb_new))
        }
        function cos_old() {
            expression: sum(query(q) * attribute(emb_old))
        }
        first-phase {
            expression {
                if (attribute(space) == 1,
                    (cos_new() - query(mu_n)) / query(sd_n),
                    (cos_old() - query(mu_o)) / query(sd_o))
            }
        }
    }

    # The same mixed state ranked on raw cosine, so the raw and normalized
    # comparison differs only by the normalization.
    rank-profile mixed_cosine {
        inputs {
            query(q) tensor<float>(x[384])
        }
        function cos_new() {
            expression: sum(query(q) * attribute(emb_new))
        }
        function cos_old() {
            expression: sum(query(q) * attribute(emb_old))
        }
        first-phase {
            expression {
                if (attribute(space) == 1, cos_new(), cos_old())
            }
        }
    }

    # The other way to migrate: overwrite the one vector field in place, so a
    # single HNSW graph ends up holding vectors from both models. `space` still
    # records which model wrote each document's vector. Used by
    # scripts/inplace_vs_dualfield.py to test whether the second field is what
    # makes per-space normalization work on a graph.
    rank-profile inplace_normalized {
        inputs {
            query(q) tensor<float>(x[384])
            query(mu_n) double
            query(sd_n) double
            query(mu_o) double
            query(sd_o) double
        }
        function cos_old() {
            expression: sum(query(q) * attribute(emb_old))
        }
        first-phase {
            expression {
                if (attribute(space) == 1,
                    (cos_old() - query(mu_n)) / query(sd_n),
                    (cos_old() - query(mu_o)) / query(sd_o))
            }
        }
    }

    rank-profile inplace_cosine {
        inputs {
            query(q) tensor<float>(x[384])
        }
        first-phase {
            expression: sum(query(q) * attribute(emb_old))
        }
    }
}
